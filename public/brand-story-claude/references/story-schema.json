{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "temoa Brand Story",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "brandName",
    "marketplace",
    "language",
    "background",
    "cards"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "brandName": {
      "type": "string",
      "minLength": 1
    },
    "marketplace": {
      "enum": [
        "de",
        "com",
        "co.uk",
        "fr",
        "it",
        "es",
        "nl",
        "se",
        "pl",
        "com.be"
      ]
    },
    "language": {
      "type": "string"
    },
    "brandFacts": {
      "type": "string"
    },
    "instructions": {
      "type": "string"
    },
    "planning": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "mode",
        "storeUrl",
        "goal",
        "categories",
        "focusProducts",
        "includeFocusGrid"
      ],
      "properties": {
        "mode": {
          "enum": [
            "store",
            "manual"
          ]
        },
        "storeUrl": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        },
        "categories": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "id",
              "name",
              "url",
              "selected",
              "asins"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "selected": {
                "type": "boolean"
              },
              "asins": {
                "type": "array",
                "maxItems": 4,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9]{10}$"
                }
              },
              "status": {
                "type": "string"
              }
            }
          }
        },
        "focusProducts": {
          "type": "array",
          "maxItems": 19,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "asin",
              "reason"
            ],
            "properties": {
              "asin": {
                "type": "string",
                "pattern": "^[A-Za-z0-9]{10}$"
              },
              "reason": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "includeFocusGrid": {
          "type": "boolean"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "audience": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "benefits": {
          "type": "string"
        },
        "materials": {
          "type": "string"
        },
        "products": {
          "type": "string"
        },
        "destinations": {
          "type": "string"
        },
        "cardCount": {
          "type": "string"
        }
      }
    },
    "background": {
      "type": "object",
      "required": [
        "desktop",
        "mobile",
        "desktopBrief",
        "mobileBrief",
        "desktopCopy",
        "mobileCopy"
      ],
      "properties": {
        "desktop": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "url",
                "width",
                "height",
                "size"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "name": {
                  "type": "string"
                },
                "width": {
                  "type": "number",
                  "minimum": 0
                },
                "height": {
                  "type": "number",
                  "minimum": 0
                },
                "size": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          ]
        },
        "mobile": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "url",
                "width",
                "height",
                "size"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "name": {
                  "type": "string"
                },
                "width": {
                  "type": "number",
                  "minimum": 0
                },
                "height": {
                  "type": "number",
                  "minimum": 0
                },
                "size": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          ]
        },
        "brief": {
          "type": "string"
        },
        "copy": {
          "type": "string"
        },
        "desktopBrief": {
          "type": "string"
        },
        "mobileBrief": {
          "type": "string"
        },
        "desktopCopy": {
          "type": "string"
        },
        "mobileCopy": {
          "type": "string"
        }
      }
    },
    "cards": {
      "type": "array",
      "maxItems": 19,
      "items": {
        "type": "object",
        "required": [
          "id",
          "fileKey",
          "type",
          "brief",
          "copy",
          "image",
          "slots"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "fileKey": {
            "type": "string",
            "pattern": "^card-[0-9]{2,}$"
          },
          "type": {
            "enum": [
              "media",
              "grid"
            ]
          },
          "gridMode": {
            "enum": [
              "individual",
              "composite"
            ]
          },
          "title": {
            "type": "string"
          },
          "brief": {
            "type": "string"
          },
          "copy": {
            "type": "string"
          },
          "assetFile": {
            "type": "string"
          },
          "image": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "url",
                  "width",
                  "height",
                  "size"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "name": {
                    "type": "string"
                  },
                  "width": {
                    "type": "number",
                    "minimum": 0
                  },
                  "height": {
                    "type": "number",
                    "minimum": 0
                  },
                  "size": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            ]
          },
          "headline": {
            "type": "string",
            "maxLength": 30
          },
          "shopUrl": {
            "type": "string"
          },
          "slots": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "asin",
                "url",
                "image",
                "productImage",
                "assetFile"
              ],
              "properties": {
                "brief": {
                  "type": "string"
                },
                "imageMode": {
                  "enum": [
                    "product",
                    "custom"
                  ]
                },
                "asin": {
                  "type": "string",
                  "pattern": "^$|^[A-Za-z0-9]{10}$"
                },
                "url": {
                  "type": "string"
                },
                "assetFile": {
                  "type": "string"
                },
                "image": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "required": [
                        "url",
                        "width",
                        "height",
                        "size"
                      ],
                      "properties": {
                        "url": {
                          "type": "string",
                          "format": "uri"
                        },
                        "name": {
                          "type": "string"
                        },
                        "width": {
                          "type": "number",
                          "minimum": 0
                        },
                        "height": {
                          "type": "number",
                          "minimum": 0
                        },
                        "size": {
                          "type": "number",
                          "minimum": 0
                        }
                      }
                    }
                  ]
                },
                "productImage": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "required": [
                        "url"
                      ],
                      "properties": {
                        "url": {
                          "type": "string"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "grid"
                }
              }
            },
            "then": {
              "required": [
                "headline",
                "shopUrl"
              ],
              "properties": {
                "slots": {
                  "minItems": 4,
                  "maxItems": 4
                }
              }
            },
            "else": {
              "properties": {
                "slots": {
                  "maxItems": 0
                }
              }
            }
          }
        ]
      }
    },
    "references": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "required": [
              "url",
              "width",
              "height",
              "size"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "name": {
                "type": "string"
              },
              "width": {
                "type": "number",
                "minimum": 0
              },
              "height": {
                "type": "number",
                "minimum": 0
              },
              "size": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        ]
      }
    }
  }
}
