 def _embed_tool_url(meta):
     """Konfigurierte Tool-URL; bei Bedarf mit einer sicheren Standardadresse."""
     configured = os.environ.get(meta["env"])
+    if configured is None and meta["env"] == "EMBED_BRAND_STORY_URL":
+        from urllib.parse import urlsplit, urlunsplit
+        store_url = os.environ.get("EMBED_STORE_BUILDER_URL", "").strip()
+        if store_url:
+            parts = urlsplit(store_url)
+            return urlunsplit((parts.scheme, parts.netloc, "/brand-stories", "embed=1", ""))
     return (configured if configured is not None else meta.get("default_url", "")).strip()
 
 
